# ============================================================
# Copy this file:  cp .env.example .env   then edit .env
# NEVER commit .env to Git.
# ============================================================

# --- Security: make a long random key with:  openssl rand -hex 32
API_KEY=change-this-key

# --- Speech-to-text (faster-whisper)
STT_MODEL=large-v3-turbo
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16
# auto = detect Hindi / English automatically. Do not force English.
STT_LANGUAGE=auto
STT_BEAM_SIZE=5
STT_BEST_OF=5
STT_VAD_FILTER=true
# false reduces Whisper "repeat loops" on long calls; set true to compare
STT_CONDITION_ON_PREVIOUS_TEXT=false

# --- Stereo channel -> speaker label (swap if labels come out reversed)
CHANNEL_1_SPEAKER=Agent
CHANNEL_2_SPEAKER=Customer
MONO_SPEAKER=Speaker

# --- Domain words to help Whisper spell them (comma separated), e.g.
# VOCAB=Dialdesk, Callmaster, website, login, CRM   (one line, no quotes needed)
VOCAB=
# hotwords (every part of the call) or initial_prompt (start of call only)
STT_VOCAB_MODE=hotwords

# --- Local LLM (vLLM on this same server). No OpenAI cloud key is used anywhere.
LLM_URL=http://127.0.0.1:8000/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0
LLM_GUIDED_JSON=true
LLM_TIMEOUT_SECONDS=300

# --- vLLM server settings (starting values, tune on your GPU)
VLLM_GPU_MEMORY_UTILIZATION=0.55
VLLM_MAX_MODEL_LEN=16384
# Only needed for gated Hugging Face models (Qwen2.5 is not gated)
HF_TOKEN=

# --- Queue
REDIS_URL=redis://127.0.0.1:6379/0
JOB_TIMEOUT_SECONDS=1800
SYNC_TIMEOUT_SECONDS=900

# --- API
API_PORT=8080
# 0.0.0.0 = listen on all network cards (then protect with the firewall, README step 16)
API_HOST=0.0.0.0
MAX_UPLOAD_MB=300
WEBHOOK_TIMEOUT_SECONDS=15
LOG_LEVEL=INFO

# --- Folders (defaults are inside the project folder; change only if needed)
# DATA_DIR=/home/ubuntu/callmaster-ai/data
# STT_MODEL_DIR=/home/ubuntu/callmaster-ai/models/whisper
